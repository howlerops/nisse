# Copy to /etc/nisse/nisse.env on the engine host, fill in, and make it readable by the engine
# user only (chmod 600). Never commit the filled-in file: this example holds names, no values.

# Postgres, connecting as a login role that is a member of nisse_writer.
DATABASE_URL=

# Alpaca PAPER keys. Live keys do not go on this host in this phase.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# At least 16 bytes; decides which decisions are hidden from agents. Choose once, keep it.
NISSE_HOLDOUT_SALT=
