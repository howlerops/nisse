# Copy to /etc/nisse/nisse.env on the engine host, fill in, and make it readable by the engine
# user only (chmod 600). Never commit the filled-in file: this example holds names, no values.

# Postgres, connecting as a login role that is a member of nisse_writer.
DATABASE_URL=

# Alpaca PAPER keys. Live keys do not go on this host in this phase.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# At least 16 bytes; decides which decisions are hidden from agents. Choose once, keep it.
NISSE_HOLDOUT_SALT=

# The public verification key as hex (64 digits), printed by `nisse-sign --public-key`. Not a
# secret. The secret signing key is never put on this host. Needed once the engine config says
# "required": true under "signature" (docs/runbooks/research-agents.md).
NISSE_VERIFY_KEY=

# Optional: the most verbose log level written to the cron logs (error, warn, info, debug,
# trace, off). Default info.
#NISSE_LOG=info
